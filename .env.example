# Public values only: they end up in the generated HTML. Never put secrets here.
# Copy to .env for local development; CI and deploy set them as workflow variables.

# WhatsApp number in international format, digits only (country + area + number).
# Empty hides the floating button and the "Hablemos" CTA.
PUBLIC_WHATSAPP_NUMBER=541164521396

# Social profile URLs (https). An empty value hides that icon in the footer.
PUBLIC_LINKEDIN_URL=
PUBLIC_GITHUB_URL=https://github.com/Luis-Morinigo
PUBLIC_X_URL=
PUBLIC_INSTAGRAM_URL=

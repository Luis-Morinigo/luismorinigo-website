---
import Icon from '@/components/Icon.astro';
import { localizedPath, t, toLocale } from '@/i18n';

interface Props {
  /** "hero": larger button with an arrow. */
  size?: 'default' | 'hero';
  class?: string;
}

const { size = 'default', class: className } = Astro.props;
const locale = toLocale(Astro.currentLocale);
// "Hablemos" leads to the contact section of the home, in the same tab.
const href = localizedPath(locale, '/#contacto');
---

<a
  href={href}
  class:list={[
    'btn-primary tracking-wider uppercase',
    size === 'hero' ? 'min-h-13.5 px-6.5 text-base' : 'text-sm',
    className,
  ]}
>
  {t(locale, 'header.cta')}
  {size === 'hero' && <Icon name="arrow-right" class="size-4.5" />}
</a>

---
interface Props {
  /** Id of the h2, referenced by the section's aria-labelledby. */
  id: string;
  title: string;
  /** Key phrase, shown after the title with the brand gradient. */
  highlight: string;
  lead: string;
  /** Less space below, when the section has more content before its cards. */
  compact?: boolean;
}

const { id, title, highlight, lead, compact = false } = Astro.props;
---

<div class:list={['text-center', compact ? 'mb-9' : 'mb-12 md:mb-14']}>
  <h2 id={id} class="mb-2.5 text-section leading-tight font-extrabold text-balance">
    {title} <span class="gradient-text">{highlight}</span>
  </h2>
  <p class="mx-auto max-w-2xl text-muted-foreground">{lead}</p>
</div>

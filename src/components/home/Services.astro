---
import type { CollectionEntry } from 'astro:content';
import Card from '@/components/Card.astro';
import Icon from '@/components/Icon.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  home: CollectionEntry<'home'>['data'];
}

const { services } = Astro.props.home;
---

<Section id="servicios" labelledby="servicios-title">
  <SectionHeading
    id="servicios-title"
    title={services.title}
    highlight={services.highlight}
    lead={services.lead}
  />

  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,15.5rem),1fr))] gap-5">
    {services.items.map((item) => (
      <Card hover class="flex flex-col gap-3.5 p-7">
        <Icon name={item.icon} class="size-7.5 text-primary" />
        <h3 class="text-xl font-bold">{item.title}</h3>
        <p class="text-base text-muted-foreground">{item.text}</p>
      </Card>
    ))}
  </div>
</Section>

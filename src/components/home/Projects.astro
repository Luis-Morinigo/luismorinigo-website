---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Card from '@/components/Card.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { t, toLocale } from '@/i18n';
import { getProjects } from '@/lib/content';

interface Props {
  home: CollectionEntry<'home'>['data'];
}

const { projects: heading } = Astro.props.home;
const locale = toLocale(Astro.currentLocale);
const projects = await getProjects(locale);
---

<Section id="proyectos" labelledby="proyectos-title">
  <SectionHeading
    id="proyectos-title"
    title={heading.title}
    highlight={heading.highlight}
    lead={heading.lead}
  />

  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))] gap-6">
    {projects.map(({ data: project }) => (
      <Card hover class="flex flex-col overflow-hidden">
        {project.image ? (
          <Image
            src={project.image}
            alt={project.imageAlt ?? ''}
            widths={[400, 800]}
            sizes="(min-width: 64rem) 25rem, (min-width: 40rem) 50vw, 100vw"
            class="aspect-16/10 w-full border-b border-border object-cover"
          />
        ) : (
          // Placeholder only while the entry is a draft: the schema requires the image to publish.
          <div
            class="flex aspect-16/10 items-center justify-center border-b border-border bg-secondary p-4 text-center text-sm text-muted-foreground"
            aria-hidden="true"
          >
            [{t(locale, 'placeholder.projectImage')}]
          </div>
        )}
        <div class="flex flex-1 flex-col gap-3 p-6">
          <h3 class="text-xl font-bold">{project.title}</h3>
          <p class="flex-1 text-base text-muted-foreground">{project.description}</p>
          <ul class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <li class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                {tag}
              </li>
            ))}
          </ul>
        </div>
      </Card>
    ))}
  </div>
</Section>

---
import type { CollectionEntry } from 'astro:content';
import CtaLink from '@/components/CtaLink.astro';
import HeroFacets from '@/components/home/HeroFacets.astro';
import PauseButton from '@/components/PauseButton.astro';
import { t, toLocale } from '@/i18n';

interface Props {
  home: CollectionEntry<'home'>['data'];
}

const { home } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const { slides, secondaryCta } = home.hero;
---

<section id="hero" class="relative overflow-hidden border-b border-secondary" data-hero>
  <h1 class="sr-only">{home.title}</h1>

  <div class="mx-auto grid max-w-310 items-center gap-8 px-4 pt-9 pb-10 sm:px-6 md:pt-16 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-10 lg:px-10 lg:pt-28">
    <HeroFacets class="mx-auto w-38 sm:w-52 lg:order-last lg:w-full lg:max-w-110" />

    <div class="min-w-0">
      <div class="hero-panels flex flex-col gap-12" data-hero-panels>
        {slides.map((slide, i) => (
          <div
            id={`hero-panel-${i}`}
            class="hero-panel"
            data-hero-panel
            data-active={i === 0 ? '' : undefined}
          >
            <p class="mb-3.5 text-eyebrow font-bold tracking-eyebrow text-primary uppercase md:mb-4.5">
              {slide.eyebrow}
            </p>
            <h2 class="mb-4 text-hero font-extrabold text-balance md:mb-5.5">
              {slide.title} <span class="gradient-text">{slide.highlight}</span>
            </h2>
            <p class="max-w-xl text-lead text-muted-foreground">{slide.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <CtaLink size="hero" />
        <a href="#metodologia" class="btn-ghost min-h-13.5 px-6 text-base tracking-wider uppercase">
          {secondaryCta}
        </a>
      </div>
    </div>
  </div>

  <!-- The tabs only work with JavaScript; without it they are not rendered. -->
  <div class="js-only mx-auto flex max-w-310 items-end gap-4 px-4 pb-10 sm:px-6 lg:px-10">
    <div
      role="tablist"
      aria-label={t(locale, 'hero.tablistLabel')}
      class="grid min-w-0 flex-1 grid-cols-3 gap-2 sm:gap-4"
    >
      {slides.map((slide, i) => (
        <button
          type="button"
          role="tab"
          id={`hero-tab-${i}`}
          aria-controls={`hero-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="hero-tab group flex min-h-11 cursor-pointer flex-col justify-center gap-3 text-left"
        >
          <span class="block h-0.75 overflow-hidden rounded-full bg-border">
            <span class="hero-tab-fill block h-full origin-left bg-primary" />
          </span>
          <span class="sr-only text-nav font-semibold tracking-nav text-muted-foreground uppercase transition-colors group-hover:text-foreground group-aria-selected:text-foreground sm:not-sr-only">
            {slide.eyebrow}
          </span>
        </button>
      ))}
    </div>
    <PauseButton pauseLabel={t(locale, 'hero.pause')} playLabel={t(locale, 'hero.play')} />
  </div>
</section>

<script>
  import '@/scripts/hero-tabs';
</script>

<style>
  /* With JavaScript the messages share one slot (the tallest sets the height,
     so nothing jumps) and only the active one is shown. Without it, all three
     are read one after the other. */
  :global(.js) .hero-panels {
    display: grid;
  }
  :global(.js) .hero-panel {
    grid-area: 1 / 1;
  }
  :global(.js) .hero-panel:not([data-active]) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-panel[data-active] {
      animation: hero-panel-in 0.6s ease-out both;
    }
  }

  /* Progress of the active tab: runs for the 6 s of each message and stops while paused. */
  .hero-tab-fill {
    scale: 0 1;
  }
  .hero-tab[data-done] .hero-tab-fill {
    scale: 1 1;
  }
  .hero-tab[aria-selected='true'] .hero-tab-fill {
    animation: hero-progress 6s linear forwards;
  }
  [data-paused] .hero-tab[aria-selected='true'] .hero-tab-fill {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-tab[aria-selected='true'] .hero-tab-fill {
      animation: none;
      scale: 1 1;
    }
  }

  @keyframes hero-progress {
    to {
      scale: 1 1;
    }
  }

  @keyframes hero-panel-in {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
</style>
